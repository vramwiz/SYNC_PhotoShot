<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{715B1E6E-C999-49EA-BAF0-6E6037D62A29}</ProjectGuid>
    <ProjectVersion>20.4</ProjectVersion>
    <FrameworkType>None</FrameworkType>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <ProjectName Condition="'$(ProjectName)'==''">SYNC_PhotoShot</ProjectName>
    <TargetedPlatforms>2</TargetedPlatforms>
    <AppType>Library</AppType>
    <MainSource>SYNC_PhotoShot.dpr</MainSource>
    <Base>True</Base>
    <ProjectDir>$(MSBuildProjectDirectory)</ProjectDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_1)'=='true') or '$(Cfg_1_Win64)'!=''">
    <Cfg_1_Win64>true</Cfg_1_Win64>
    <CfgParent>Cfg_1</CfgParent>
    <Cfg_1>true</Cfg_1>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
    <Cfg_2>true</Cfg_2>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Cfg_2)'=='true') or '$(Cfg_2_Win64)'!=''">
    <Cfg_2_Win64>true</Cfg_2_Win64>
    <CfgParent>Cfg_2</CfgParent>
    <Cfg_2>true</Cfg_2>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_DcuOutput>.\$(Platform)\$(Config)\DCU</DCC_DcuOutput>
    <GenDll>true</GenDll>
    <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
    <SanitizedProjectName>SYNC_PhotoShot</SanitizedProjectName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_DebugDCUs>true</DCC_DebugDCUs>
    <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
    <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    <DCC_DebugInformation>1</DCC_DebugInformation>
    <DCC_RemoteDebug>true</DCC_RemoteDebug>
    <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <BT_BuildType>Debug</BT_BuildType>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1_Win64)'!=''">
    <DCC_DcuOutput>.\Win64\Debug\DCU</DCC_DcuOutput>
    <DCC_ExeOutput>.\Win64\Debug</DCC_ExeOutput>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2)'!=''">
    <DCC_Optimize>true</DCC_Optimize>
    <BT_BuildType>Release</BT_BuildType>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>0</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_2_Win64)'!=''">
    <DCC_DcuOutput>.\Win64\Release\DCU</DCC_DcuOutput>
    <VerInfo_Locale>1041</VerInfo_Locale>
    <Manifest_File>(なし)</Manifest_File>
    <AppDPIAwarenessMode>none</AppDPIAwarenessMode>
    <DCC_ExeOutput>.\Win64\Release</DCC_ExeOutput>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <DCCReference Include="Source\Lib\AviUtl2FilterTypes.pas" />
    <DCCReference Include="Source\Lib\FilterTable\PluginFilterTable.pas" />
    <DCCReference Include="Source\Plugin\Filter\SYNC_PhotoShot_FilterPlugin.pas" />
    <DCCReference Include="Source\Lib\Smartphone\SYNC_SmartphoneRenderer.pas" />
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">SYNC_PhotoShot.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">False</Platform>
        <Platform value="Win64">True</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
  <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')" />
  <Import Project="$(MSBuildProjectName).deployproj" Condition="Exists('$(MSBuildProjectName).deployproj')" />
  <PropertyGroup Condition="'$(Config)'=='Debug' And '$(Platform)'=='Win64'">
    <PostBuildEvent>(if not exist "C:\ProgramData\aviutl2\Plugin\SYNC_PhotoShot\." mkdir "C:\ProgramData\aviutl2\Plugin\SYNC_PhotoShot") &amp;&amp; copy /Y "$(OUTPUTDIR)$(PROJECTNAME).dll" "$(OUTPUTDIR)$(PROJECTNAME).auf2" &amp;&amp; copy /Y "$(OUTPUTDIR)$(PROJECTNAME).auf2" "C:\ProgramData\aviutl2\Plugin\SYNC_PhotoShot\$(PROJECTNAME).auf2" &amp;&amp; del /Q "$(OUTPUTDIR)$(PROJECTNAME).dll"</PostBuildEvent>
    <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
    <PostBuildEventExecuteWhen>Always</PostBuildEventExecuteWhen>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' And '$(Platform)'=='Win64'">
    <PostBuildEvent>(if not exist "C:\ProgramData\aviutl2\Plugin\SYNC_PhotoShot\." mkdir "C:\ProgramData\aviutl2\Plugin\SYNC_PhotoShot") &amp;&amp; copy /Y "$(OUTPUTDIR)$(PROJECTNAME).dll" "$(OUTPUTDIR)$(PROJECTNAME).auf2" &amp;&amp; copy /Y "$(OUTPUTDIR)$(PROJECTNAME).auf2" "C:\ProgramData\aviutl2\Plugin\SYNC_PhotoShot\$(PROJECTNAME).auf2" &amp;&amp; del /Q "$(OUTPUTDIR)$(PROJECTNAME).dll" &amp;&amp; (if exist "$(OUTPUTDIR)$(PROJECTNAME).rsm" del /Q "$(OUTPUTDIR)$(PROJECTNAME).rsm")</PostBuildEvent>
    <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
    <PostBuildEventExecuteWhen>Always</PostBuildEventExecuteWhen>
  </PropertyGroup>
</Project>